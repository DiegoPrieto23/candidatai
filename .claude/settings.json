{
  "env": {
    "MCP_TIMEOUT": "60000"
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run alembic *)",
      "Bash(uv run jh *)",
      "Bash(uv run --directory backend jh *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm build *)",
      "Bash(pnpm typecheck *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "mcp__jobhunter__get_status",
      "mcp__jobhunter__list_jobs",
      "mcp__jobhunter__get_job",
      "mcp__jobhunter__save_extraction",
      "mcp__jobhunter__get_extraction",
      "mcp__jobhunter__get_timeline",
      "mcp__jobhunter__get_profile",
      "mcp__jobhunter__get_context",
      "mcp__jobhunter__get_match",
      "mcp__jobhunter__get_cv_content",
      "mcp__jobhunter__list_cv_templates",
      "mcp__jobhunter__list_sources",
      "mcp__jobhunter__list_followups_due",
      "mcp__jobhunter__list_upcoming",
      "mcp__jobhunter__get_funnel_stats",
      "mcp__jobhunter__get_skill_gaps",
      "mcp__jobhunter__list_replies",
      "mcp__jobhunter__get_reply",
      "mcp__jobhunter__save_reply_proposal",
      "mcp__jobhunter__save_message_draft",
      "mcp__jobhunter__wait_user_action"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(uv add *)",
      "Bash(pnpm add *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/browser-profile/**)",
      "Edit(./data/browser-profile/**)"
    ]
  }
}
